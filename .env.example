# Ambiente activo: DEV o PROD. Nunca uses valores PROD para ejecutar DEV.
NEXT_PUBLIC_APP_ENV=DEV
NEXT_PUBLIC_APP_DEV_URL=http://localhost:3000
NEXT_PUBLIC_APP_PROD_URL=https://app.example.com

# Supabase (las claves deben obtenerse del proyecto correspondiente).
NEXT_PUBLIC_SUPABASE_DEV_URL=https://gholwtklihaphoevosyb.supabase.co
NEXT_PUBLIC_SUPABASE_DEV_PUBLISHABLE_KEY=
SUPABASE_DEV_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_PROD_URL=https://jeyjblxfqqlypxiaznad.supabase.co
NEXT_PUBLIC_SUPABASE_PROD_PUBLISHABLE_KEY=
SUPABASE_PROD_SERVICE_ROLE_KEY=

# OAuth Gmail separado del login Supabase/Google.
GMAIL_GOOGLE_DEV_CLIENT_ID=
GMAIL_GOOGLE_DEV_CLIENT_SECRET=
GMAIL_GOOGLE_DEV_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
# Base64 canónico de exactamente 32 bytes. Genera una clave distinta por ambiente.
GMAIL_DEV_TOKEN_ENCRYPTION_KEY=
GMAIL_DEV_SYNC_SECRET=
MIXTO_LISTO_DEV_RECIPIENT_EMAILS=
MIXTO_LISTO_DEV_ALLOWED_SENDERS=
GMAIL_DEV_ATTACHMENT_MAX_BYTES=10485760

GMAIL_GOOGLE_PROD_CLIENT_ID=
GMAIL_GOOGLE_PROD_CLIENT_SECRET=
GMAIL_GOOGLE_PROD_REDIRECT_URI=https://app.example.com/api/integrations/gmail/callback
GMAIL_PROD_TOKEN_ENCRYPTION_KEY=
GMAIL_PROD_SYNC_SECRET=
MIXTO_LISTO_PROD_RECIPIENT_EMAILS=
MIXTO_LISTO_PROD_ALLOWED_SENDERS=
